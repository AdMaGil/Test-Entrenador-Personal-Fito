# Copia a .env.local para desarrollo. Ambos valores son públicos por diseño:
# la protección de los datos la dan el inicio de sesión y las políticas RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima
# Activa el asistente con IA solo si has desplegado la función "coach"
# y configurado la clave del proveedor en Supabase (nunca en el navegador).
VITE_COACH_AI_ENABLED=false
